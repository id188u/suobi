<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="王嘉尔锁币工具台 — Solana 专属工具导航台">
  <title>王嘉尔锁币工具台</title>
  <style>
    /* ============ 主题变量（深色 · 金红配色） ============ */
    :root {
      --bg: #17120a;
      --bg-card: #241d12;
      --bg-soft: #2b2416;
      --text: #f1e9d8;
      --text-secondary: #a2937a;
      --border: #3b3322;
      --accent: #e5c15a;
      --accent-strong: #f0cf6a;
      --accent-soft: #33290e;
      --gold: #e5c15a;
      --success: #22c55e;
      --danger: #ef4444;
      --glow: rgba(229, 193, 90, 0.07);
      --shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
      --shadow-hover: 0 12px 32px rgba(0, 0, 0, 0.65);
      --topbar-bg: rgba(20, 16, 9, 0.86);
    }

    [data-theme="light"] {
      --bg: #f6f1e6;
      --bg-card: #fffdf7;
      --bg-soft: #f3ebd7;
      --text: #2b2116;
      --text-secondary: #8a7a60;
      --border: #e7dbbf;
      --accent: #b8860b;
      --accent-strong: #9a7000;
      --accent-soft: #fcf3d9;
      --gold: #d4af37;
      --glow: rgba(212, 175, 55, 0.10);
      --shadow: 0 2px 6px rgba(139, 106, 30, 0.08);
      --shadow-hover: 0 12px 30px rgba(139, 106, 30, 0.18);
      --topbar-bg: rgba(255, 253, 247, 0.82);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    [hidden] { display: none !important; }
    html { scroll-behavior: smooth; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
        "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
      background:
        radial-gradient(1000px 420px at 85% -10%, var(--glow), transparent 60%),
        radial-gradient(800px 380px at 5% 110%, var(--glow), transparent 55%),
        var(--bg);
      background-attachment: fixed;
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      transition: background-color 0.25s ease, color 0.25s ease;
    }

    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 8px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--gold); }

    /* ============ 顶栏 ============ */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 20;
      background: var(--topbar-bg);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    .topbar-inner {
      max-width: 1080px;
      margin: 0 auto;
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand { display: flex; align-items: center; gap: 10px; }

    .brand-badge {
      width: 34px; height: 34px;
      border-radius: 10px;
      background: linear-gradient(135deg, #f8d974, #c9a227);
      display: flex; align-items: center; justify-content: center;
      font-size: 17px;
      box-shadow: 0 2px 10px rgba(201, 162, 39, 0.45);
    }

    .brand-name { font-size: 16px; font-weight: 800; letter-spacing: 0.5px; }

    .topbar-actions { display: flex; gap: 10px; }

    .toolbar-btn {
      width: 38px; height: 38px;
      border: 1px solid var(--border);
      border-radius: 11px;
      background: var(--bg-card);
      color: var(--text);
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      box-shadow: var(--shadow);
      transition: background 0.2s, color 0.2s, transform 0.2s, box-shadow 0.2s;
      text-decoration: none;
    }

    .toolbar-btn:hover { background: var(--accent-soft); color: var(--accent); }
    .toolbar-btn svg { width: 18px; height: 18px; }
    .theme-toggle:hover { transform: rotate(20deg); }

    /* ============ Hero 横幅 ============ */
    .hero {
      position: relative;
      overflow: hidden;
      text-align: center;
      color: #fff;
      padding: 52px 24px 46px;
      background:
        radial-gradient(900px 340px at 82% -20%, rgba(255, 215, 0, 0.22), transparent 60%),
        radial-gradient(700px 300px at 12% 130%, rgba(255, 180, 80, 0.16), transparent 55%),
        linear-gradient(135deg, #961838 0%, #66101f 55%, #430b15 100%);
    }

    .hero::before {
      content: "";
      position: absolute;
      left: 50%; top: -120px;
      transform: translateX(-50%);
      width: 420px; height: 420px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 215, 0, 0.14), transparent 65%);
      pointer-events: none;
    }

    .hero-eyebrow {
      position: relative;
      font-size: 12px; letter-spacing: 6px;
      color: rgba(255, 255, 255, 0.8);
      margin-bottom: 10px;
    }

    .hero-title {
      position: relative;
      font-size: 42px; font-weight: 800; line-height: 1.15;
      background: linear-gradient(115deg, #ffe9a8 0%, #ffd700 45%, #ffb347 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.28));
    }

    .hero-subtitle {
      position: relative;
      margin-top: 10px;
      font-size: 14px;
      color: rgba(255, 255, 255, 0.85);
    }

    .hero-stats {
      position: relative;
      margin-top: 22px;
      display: flex; gap: 10px;
      justify-content: center; flex-wrap: wrap;
    }

    .stat-pill {
      padding: 7px 16px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.13);
      border: 1px solid rgba(255, 255, 255, 0.26);
      backdrop-filter: blur(6px);
      font-size: 12.5px;
      color: #fff;
    }

    /* ============ 内容区 ============ */
    .container {
      max-width: 1080px;
      width: 100%;
      margin: 0 auto;
      padding: 34px 24px 20px;
      flex: 1;
    }

    .group { margin-bottom: 36px; }

    .group-title {
      display: flex; align-items: center; gap: 10px;
      font-size: 16px; font-weight: 700;
      margin-bottom: 16px;
    }

    .group-title::after {
      content: "";
      flex: 1; height: 1px;
      background: linear-gradient(90deg, var(--border), transparent);
    }

    .group-icon {
      width: 32px; height: 32px;
      border-radius: 9px; flex-shrink: 0;
      background: linear-gradient(135deg, var(--accent-soft), var(--bg-soft));
      border: 1px solid var(--border);
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 16px;
    }

    .sites-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 16px;
    }

    .site-card {
      position: relative;
      overflow: hidden;
      display: flex; align-items: center; gap: 13px;
      padding: 16px 18px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: var(--shadow);
      text-decoration: none;
      color: var(--text);
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      animation: cardIn 0.4s ease both;
    }

    .site-card::before {
      content: "";
      position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
      background: linear-gradient(180deg, var(--gold), transparent);
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    .site-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
      border-color: var(--gold);
    }

    .site-card:hover::before { opacity: 1; }

    @keyframes cardIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: none; }
    }

    .site-icon {
      width: 44px; height: 44px;
      border-radius: 12px; flex-shrink: 0;
      background: linear-gradient(135deg, var(--accent-soft), var(--bg-soft));
      border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: 20px;
      overflow: hidden;
    }

    .site-icon .fallback { font-weight: 700; color: var(--accent); font-size: 18px; }

    .site-info { flex: 1; min-width: 0; }

    .site-name {
      font-size: 14px; font-weight: 600;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    .site-desc {
      font-size: 12px; color: var(--text-secondary);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      margin-top: 3px;
    }

    .status-dot {
      width: 10px; height: 10px;
      border-radius: 50%;
      flex-shrink: 0; margin-left: auto;
    }

    .status-dot.online { background: var(--success); box-shadow: 0 0 8px rgba(34, 197, 94, 0.55); }

    /* ============ 密码验证弹窗 ============ */
    .pwd-mask {
      position: fixed; inset: 0; z-index: 50;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      display: flex; align-items: center; justify-content: center;
      padding: 20px;
    }

    .pwd-box {
      width: 100%; max-width: 340px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 26px 22px;
      text-align: center;
      box-shadow: var(--shadow-hover);
      animation: cardIn 0.25s ease both;
    }

    .pwd-icon { font-size: 28px; margin-bottom: 10px; }
    .pwd-box h3 { font-size: 17px; margin-bottom: 6px; }
    .pwd-desc { font-size: 12.5px; color: var(--text-secondary); margin-bottom: 16px; }

    .pwd-input {
      width: 100%; padding: 12px 14px;
      background: var(--bg-soft);
      border: 1px solid var(--border);
      border-radius: 12px;
      color: var(--text); font-size: 16px; text-align: center;
      letter-spacing: 4px; outline: none;
    }
    .pwd-input:focus { border-color: var(--gold); }

    .pwd-error { margin-top: 10px; font-size: 12.5px; color: var(--danger); }

    .pwd-actions { display: flex; gap: 10px; margin-top: 18px; }
    .pwd-btn {
      flex: 1; padding: 11px 0; border-radius: 12px; border: 1px solid var(--border);
      font-size: 14px; cursor: pointer; transition: 0.2s;
    }
    .pwd-btn.ghost { background: transparent; color: var(--text-secondary); }
    .pwd-btn.primary {
      background: linear-gradient(135deg, #f8d974, #c9a227);
      color: #2b2116; font-weight: 700; border: none;
    }

    .pwd-box.shake { animation: shake 0.3s; }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-8px); }
      75% { transform: translateX(8px); }
    }

    /* ============ 轻提示 Toast ============ */
    .toast {
      position: fixed; left: 50%; bottom: 40px; transform: translateX(-50%);
      z-index: 60; padding: 11px 18px; border-radius: 12px;
      background: var(--bg-card); border: 1px solid var(--border);
      color: var(--text); font-size: 13px; box-shadow: var(--shadow-hover);
      max-width: 80vw; text-align: center;
    }

    /* ============ 页脚 ============ */
    .footer {
      text-align: center;
      padding: 26px 24px 40px;
      color: var(--text-secondary);
      font-size: 12.5px;
    }

    .footer-tg {
      display: inline-flex; align-items: center; gap: 6px;
      margin-bottom: 8px;
      padding: 8px 18px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--bg-card);
      box-shadow: var(--shadow);
      font-size: 13px;
    }

    .footer-tg svg { color: #229ed9; }
    .footer-tg a { color: var(--accent); font-weight: 600; text-decoration: none; }
    .footer-tg a:hover { text-decoration: underline; }

    .copy-btn {
      margin-left: 4px;
      padding: 4px 12px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--bg-soft);
      color: var(--text);
      font-size: 12px;
      cursor: pointer;
    }
    .copy-btn:hover { border-color: var(--gold); color: var(--accent); }

    @media (max-width: 600px) {
      .sites-grid { grid-template-columns: 1fr; }
      .container { padding: 24px 16px 16px; }
      .hero { padding: 40px 16px 36px; }
      .hero-title { font-size: 30px; }
      .brand-name { font-size: 15px; }
    }
  </style>
</head>
<body>

  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <span class="brand-badge">💰</span>
        <span class="brand-name" id="brand-name">王嘉尔工具箱</span>
      </div>
      <div class="topbar-actions">
        <a class="toolbar-btn" id="tg-link" href="https://t.me/suobiu" rel="noopener noreferrer" aria-label="Telegram 联系 @suobiu" title="TG 联系 @suobiu">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 2 11 13"></path>
            <path d="M22 2 15 22l-4-9-9-4 20-7z"></path>
          </svg>
        </a>
        <button class="toolbar-btn" id="refresh-status" aria-label="重新检测" title="重新检测">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
        </button>
        <button class="toolbar-btn theme-toggle" id="theme-toggle" aria-label="切换深色/浅色主题" title="切换主题">
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <section class="hero">
    <p class="hero-eyebrow">✦ 王嘉尔@suobiu ✦</p>
    <h2 class="hero-title" id="hero-title">王嘉尔锁币工具台</h2>
    <p class="hero-subtitle">Solana 专属工具台 · 点击直达</p>
    <div class="hero-stats">
      <span class="stat-pill" id="stat-groups">0 个分组</span>
      <span class="stat-pill" id="stat-sites">0 个工具</span>
      <span class="stat-pill" id="stat-online">🟢 0 全部在线</span>
    </div>
  </section>

  <main class="container" id="nav-groups"></main>

  <footer class="footer">
    <p class="footer-tg">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="15" height="15">
        <path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71l-4.14-3.05-1.99 1.93c-.23.23-.42.42-.83.42z"/>
      </svg>
      TG 联系：<a href="https://t.me/suobiu" rel="noopener noreferrer">@suobiu</a>
      <button class="copy-btn" id="tg-copy" type="button">复制链接</button>
    </p>
    <p>王嘉尔锁币工具台 · Solana 专属自部署导航台</p>
  </footer>

  <!-- ===== 密码验证弹窗 ===== -->
  <div class="pwd-mask" id="pwd-mask" hidden>
    <div class="pwd-box" role="dialog" aria-modal="true" aria-labelledby="pwd-title">
      <div class="pwd-icon">🔒</div>
      <h3 id="pwd-title">请输入访问密码</h3>
      <p class="pwd-desc" id="pwd-desc">此工具需验证密码后进入</p>
      <input type="password" id="pwd-input" class="pwd-input" inputmode="numeric" placeholder="请输入密码" autocomplete="off">
      <p class="pwd-error" id="pwd-error" hidden>密码不正确，请重试</p>
      <div class="pwd-actions">
        <button class="pwd-btn ghost" id="pwd-cancel">取消</button>
        <button class="pwd-btn primary" id="pwd-ok">进入</button>
      </div>
    </div>
  </div>

  <div id="toast" class="toast" hidden></div>

  <script>
    /* ============ 网站数据（按需替换 url） ============ */
    window.SITE_DATA = {
      title: "王嘉尔锁币工具台",
      groups: [
        {
          name: "币发布",
          icon: "🚀",
          sites: [
            { name: "币发布工具 (Launchpad)", url: "https://4mjct2zw666a4.doubao.link/app/app_17jgcwcd6qy?show_loading=0&webview_progress_bar=1&push_animated=1&theme=light", desc: "Token-2022 一键部署代币", icon: "🪙" }
          ]
        },
        {
          name: "监控与控制台",
          icon: "📡",
          sites: [
            { name: "新池监控台", url: "https://4mjct2zw666a4.doubao.link/app/app_17jgcwcd6qy?show_loading=0&webview_progress_bar=1&push_animated=1&theme=light", desc: "新池监听面板", icon: "📊" },
            { name: "RPC 配额监控", url: "https://4mjct2zw666a4.doubao.link/app/app_17jgcwcd6qy?show_loading=0&webview_progress_bar=1&push_animated=1&theme=light", desc: "节点额度用量查看", icon: "🖥️" }
          ]
        },
        {
          name: "链上工具",
          icon: "🛠️",
          sites: [
            { name: "代币权限查询", url: "https://4mjct2zw666a4.doubao.link/app/app_17jgcwcd6qy?show_loading=0&webview_progress_bar=1&push_animated=1&theme=light", desc: "铸币 / 冻结权限核验", icon: "🔍" },
            { name: "持仓分布查看", url: "https://4mjct2zw666a4.doubao.link/app/app_17jgcwcd6qy?show_loading=0&webview_progress_bar=1&push_animated=1&theme=light", desc: "大户与持币地址分析", icon: "👥" },
            { name: "流动性检查", url: "https://4mjct2zw666a4.doubao.link/app/app_17jgcwcd6qy?show_loading=0&webview_progress_bar=1&push_animated=1&theme=light", desc: "LP 与储备余额核验", icon: "💧" },
            { name: "交易记录查询", url: "https://4mjct2zw666a4.doubao.link/app/app_17jgcwcd6qy?show_loading=0&webview_progress_bar=1&push_animated=1&theme=light", desc: "链上转账记录浏览", icon: "📜" }
          ]
        }
      ]
    };

    /* ============ 主题切换 ============ */
    const THEME_KEY = "nav-station-theme";
    const themeToggle = document.getElementById("theme-toggle");
    const iconSun = document.getElementById("icon-sun");
    const iconMoon = document.getElementById("icon-moon");

    function applyTheme(theme) {
      document.documentElement.setAttribute("data-theme", theme);
      const dark = theme === "dark";
      iconSun.style.display = dark ? "block" : "none";
      iconMoon.style.display = dark ? "none" : "block";
    }

    function currentTheme() {
      return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
    }

    function safeGet(key) {
      try { return localStorage.getItem(key); } catch (e) { return null; }
    }
    function safeSet(key, val) {
      try { localStorage.setItem(key, val); } catch (e) {}
    }

    function initTheme() {
      const saved = safeGet(THEME_KEY);
      applyTheme(saved || "dark");
    }

    themeToggle.addEventListener("click", () => {
      const next = currentTheme() === "dark" ? "light" : "dark";
      applyTheme(next);
      safeSet(THEME_KEY, next);
    });

    initTheme();

    /* ============ 渲染导航 ============ */
    const data = window.SITE_DATA || { title: "王嘉尔锁币工具台", groups: [] };

    function renderSiteIcon(site) {
      const wrap = document.createElement("div");
      wrap.className = "site-icon";
      if (site.icon) { wrap.textContent = site.icon; return wrap; }
      const fb = document.createElement("span");
      fb.className = "fallback";
      fb.textContent = site.name.trim().charAt(0).toUpperCase();
      wrap.appendChild(fb);
      return wrap;
    }

    function render() {
      const titleEl = document.getElementById("brand-name");
      const heroTitle = document.getElementById("hero-title");
      if (titleEl) titleEl.textContent = data.title;
      if (heroTitle) heroTitle.textContent = data.title;
      document.title = data.title || "王嘉尔锁币工具台";

      const container = document.getElementById("nav-groups");
      container.innerHTML = "";
      let total = 0;

      data.groups.forEach((group) => {
        const section = document.createElement("section");
        section.className = "group";

        const heading = document.createElement("h2");
        heading.className = "group-title";
        const iconSpan = document.createElement("span");
        iconSpan.className = "group-icon";
        iconSpan.textContent = group.icon || "📌";
        heading.appendChild(iconSpan);
        heading.appendChild(document.createTextNode(group.name));
        section.appendChild(heading);

        const grid = document.createElement("div");
        grid.className = "sites-grid";

        (group.sites || []).forEach((site) => {
          const a = document.createElement("a");
          a.className = "site-card";
          a.href = site.url || "#";
          a.title = site.desc || site.name;
          a.addEventListener("click", function (e) {
            e.preventDefault();
            openPwdGate(site.url, site.name);
          });

          a.appendChild(renderSiteIcon(site));

          const info = document.createElement("div");
          info.className = "site-info";
          const nameEl = document.createElement("div");
          nameEl.className = "site-name";
          nameEl.textContent = site.name;
          const descEl = document.createElement("div");
          descEl.className = "site-desc";
          descEl.textContent = site.desc || "";
          info.appendChild(nameEl);
          info.appendChild(descEl);
          a.appendChild(info);

          const dot = document.createElement("span");
          dot.className = "status-dot online";
          dot.title = "在线";
          a.appendChild(dot);

          a.style.animationDelay = `${total * 45}ms`;
          grid.appendChild(a);
          total++;
        });

        section.appendChild(grid);
        container.appendChild(section);
      });

      const statGroups = document.getElementById("stat-groups");
      if (statGroups) statGroups.textContent = `${data.groups.length} 个分组`;
      const statSites = document.getElementById("stat-sites");
      if (statSites) statSites.textContent = `${total} 个工具`;
      const statOnline = document.getElementById("stat-online");
      if (statOnline) statOnline.textContent = `🟢 ${total} 全部在线`;
    }

    render();

    /* ============ 密码访问门（密码 772369，验证通过后再跳转） ============ */
    const ACCESS_PASSWORD = "772369";
    const pwdMask = document.getElementById("pwd-mask");
    const pwdBox = document.querySelector(".pwd-box");
    const pwdInput = document.getElementById("pwd-input");
    const pwdError = document.getElementById("pwd-error");
    const pwdDesc = document.getElementById("pwd-desc");
    let pendingUrl = null;

    const toast = document.getElementById("toast");
    let toastTimer = null;
    function showToast(msg) {
      toast.textContent = msg;
      toast.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { toast.hidden = true; }, 2200);
    }

    /* ============ 复制 TG 链接（外链被拦截时的兜底） ============ */
    const TG_URL = "https://t.me/suobiu";
    const tgCopy = document.getElementById("tg-copy");

    function fallbackCopy() {
      showToast("请长按链接手动复制：" + TG_URL);
    }

    function copyTgUrl() {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(TG_URL)
          .then(() => showToast("链接已复制，请到 Telegram 粘贴打开"))
          .catch(() => fallbackCopy());
      } else {
        fallbackCopy();
      }
    }

    if (tgCopy) tgCopy.addEventListener("click", copyTgUrl);

    const refreshStatus = document.getElementById("refresh-status");
    if (refreshStatus) {
      refreshStatus.addEventListener("click", () => {
        render();
        showToast("已刷新");
      });
    }

    function openPwdGate(url, siteName) {
      pendingUrl = url;
      pwdDesc.textContent = `「${siteName}」需验证密码后进入`;
      pwdError.hidden = true;
      pwdInput.value = "";
      pwdMask.hidden = false;
      setTimeout(() => pwdInput.focus(), 50);
    }

    function closePwdGate() {
      pwdMask.hidden = true;
      pendingUrl = null;
      pwdInput.value = "";
      pwdError.hidden = true;
    }

    function submitPwd() {
      if (pwdInput.value.trim() === ACCESS_PASSWORD) {
        const target = pendingUrl;
        closePwdGate();
        if (target && target !== "#") {
          window.open(target, "_blank", "noopener,noreferrer");
        } else {
          showToast("链接待配置，暂未设置跳转地址");
        }
      } else {
        pwdError.hidden = false;
        pwdBox.classList.remove("shake");
        void pwdBox.offsetWidth;
        pwdBox.classList.add("shake");
        pwdInput.select();
      }
    }

    document.getElementById("pwd-ok").addEventListener("click", submitPwd);
    document.getElementById("pwd-cancel").addEventListener("click", closePwdGate);
    pwdInput.addEventListener("keydown", (e) => { if (e.key === "Enter") submitPwd(); });
    pwdMask.addEventListener("click", (e) => { if (e.target === pwdMask) closePwdGate(); });
  </script>
</body>
</html>